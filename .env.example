# Supabase project settings (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only - never expose to the browser. Used for validated uploads,
# moderation actions and account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public URL of the site (used for auth redirects and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact e-mail shown in the privacy policy / terms
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Identifies the app to OpenStreetMap Nominatim (required by their usage policy)
NOMINATIM_USER_AGENT=HatSpotted/0.1 (hello@example.com)
